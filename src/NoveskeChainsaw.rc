// NoveskeChainsaw.dll resources: the encrypted assets and the version/credits block.
#include "version.h"

// The Noveske's runtime assets as one encrypted payload. build.bat first runs tools\pack over
// Assets\ (generated from the purchased source art by tools\prepare_runtime.py, not in the repo):
// every asset is AES-256-GCM encrypted with a per-build key, so the DLL holds no extractable PNG
// or OBJ (src\payload.h).
DATA RCDATA "build\\gen\\payload.bin"

// Shown in the DLL's Properties > Details in Windows.
1 VERSIONINFO
FILEVERSION NOVESKE_VERSION_NUM
PRODUCTVERSION NOVESKE_VERSION_NUM
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x2
FILESUBTYPE 0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "RemArrow"
            VALUE "FileDescription", "Noveske Chainsaw - GML plugin for Geronimo"
            VALUE "FileVersion", NOVESKE_VERSION
            VALUE "InternalName", "NoveskeChainsaw"
            VALUE "OriginalFilename", "NoveskeChainsaw.dll"
            VALUE "ProductName", "Noveske Chainsaw"
            VALUE "ProductVersion", NOVESKE_VERSION
            VALUE "LegalCopyright", NOVESKE_MODEL_CREDIT ". Plugin code by RemArrow."
            VALUE "Comments", "Model: 3DMA - 3D Military Assets, www.3dmilitaryassets.com. Not affiliated with or endorsed by 3DMA, Noveske Rifleworks, Irregular Defense or Dark Matter Studios."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
